{
  "name": "tft-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"tsx scripts/tft.ts run --dev\" \"vite\"",
    "start": "tsx scripts/tft.ts run",
    "crawl": "tsx scripts/tft.ts crawl",
    "stats": "tsx scripts/tft.ts stats",
    "refresh": "tsx scripts/tft.ts refresh",
    "recluster": "tsx scripts/tft.ts recluster",
    "tft": "tsx scripts/tft.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "vite build",
    "test": "tsx test/e2e.ts",
    "golden": "tsx scripts/golden.ts",
    "resume": "tsx scripts/resume.ts",
    "cli": "tsx scripts/cli.ts",
    "test:rust": "cargo test -q && cargo clippy -q --all-targets -- -D warnings",
    "gate": "npm run test:rust && npm run golden && npm run resume && npm run cli && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
