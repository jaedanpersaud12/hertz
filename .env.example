# Copy this file to .env and fill in your key.
# Get a key at https://developer.riotgames.com (a development key expires every 24 hours;
# register a personal product to get a key that does not).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: your own account, for the summoner card and Match history page.
# Use your Riot ID exactly as shown in the client, and the server you play on.
RIOT_ID=""        # e.g. RIOT_ID="YourName#TAG" (quotes keep the # from being read as a comment)
MY_PLATFORM=na1

# Servers to crawl. One from each routing group gives you four independent rate limits:
#   americas: na1 br1 la1 la2      europe: euw1 eun1 tr1 ru me1
#   asia:     kr jp1               sea:    oc1 sg2 tw2 vn2
PLATFORMS=na1,euw1,kr,vn2

# Ranks to seed players from, highest first.
TIERS=CHALLENGER,GRANDMASTER,MASTER,DIAMOND,EMERALD,PLATINUM

# Below Master the ladder is paged (about 200 players a page). Pages per division, per server.
PAGES_PER_DIVISION=5

# Only collect matches from the last N days.
DAYS=7

# Also add every player seen in a match to the crawl list. Grows the dataset much faster.
SNOWBALL=true

# Ranked queue id for standard TFT.
RANKED_QUEUE_ID=1100

# Where the database lives.
DB_PATH=data/tft.db

# Port for the local app.
PORT=5174
